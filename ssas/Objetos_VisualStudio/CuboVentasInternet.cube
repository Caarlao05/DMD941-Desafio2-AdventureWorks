          <MdxScripts>
            <MdxScript>
              <ID>Calculos</ID>
              <Name>Calculos</Name>
              <Commands>
                <Command>
                  <Text>CALCULATE; CREATE MEMBER CURRENTCUBE.[Measures].[Ticket promedio] AS IIF(IsEmpty([Measures].[Pedidos distintos]) OR [Measures].[Pedidos distintos] = 0, NULL, [Measures].[Ventas] / [Measures].[Pedidos distintos]), FORMAT_STRING = '#,##0.00', VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Ventas Internet';</Text>
                </Command>
              </Commands>
            </MdxScript>
          </MdxScripts>
        </Cube>
      

                            <ColumnID>OrderDateKey</ColumnID>
                          </Source>
                        </KeyColumn>
                      </KeyColumns>
                      <Type>Granularity</Type>
                    </Attribute>
                  </Attributes>
                </Dimension>
                <Dimension xsi:type="RegularMeasureGroupDimension">

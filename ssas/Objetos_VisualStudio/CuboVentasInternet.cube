          <DefaultMeasure>[Measures].[Ventas]</DefaultMeasure>
          <MeasureGroups>
            <MeasureGroup>
              <ID>Ventas Internet</ID>
              <Name>Ventas Internet</Name>
              <Measures>
                <Measure>
                  <ID>Ventas</ID>
                  <Name>Ventas</Name>
                  <DataType>Currency</DataType>
                  <Source>
                    <DataType>Currency</DataType>
                    <NullProcessing>ZeroOrBlank</NullProcessing>
                    <Source xsi:type="ColumnBinding">
                      <TableID>Ventas</TableID>
                      <ColumnID>SalesAmount</ColumnID>
                    </Source>
                  </Source>
                  <FormatString>#,##0.00</FormatString>
                </Measure>
                <Measure>
                  <ID>Unidades</ID>
                  <Name>Unidades</Name>
                  <DataType>BigInt</DataType>
                  <Source>
                    <DataType>BigInt</DataType>
                    <NullProcessing>ZeroOrBlank</NullProcessing>
                    <Source xsi:type="ColumnBinding">
                      <TableID>Ventas</TableID>
                      <ColumnID>OrderQuantity</ColumnID>
                    </Source>
                  </Source>
                  <FormatString>#,##0</FormatString>
                </Measure>
                <Measure>
                  <ID>Lineas</ID>
                  <Name>Lineas</Name>
                  <AggregateFunction>Count</AggregateFunction>
                  <DataType>BigInt</DataType>
                  <Source>
                    <DataType>SmallInt</DataType>
                    <NullProcessing>ZeroOrBlank</NullProcessing>
                    <Source xsi:type="ColumnBinding">
                      <TableID>Ventas</TableID>
                      <ColumnID>SalesOrderLineNumber</ColumnID>
                    </Source>
                  </Source>
                  <FormatString>#,##0</FormatString>
                </Measure>
              </Measures>
